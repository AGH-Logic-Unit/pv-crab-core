# --- Verible Linter Configuration ---

# 1. Critical
+always-ff-non-blocking
+always-comb
+always-comb-blocking
+no-tabs

# 2. Style
+typedef-enums
+enum-name-style
+package-filename
+module-filename
+port-name-suffix
+parameter-name-style
+signal-name-style
+interface-name-style
+explicit-parameter-storage-type
+generate-label
+mismatched-labels

# 3. Removed
-line-length
