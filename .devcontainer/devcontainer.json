{
    "name": "Pulsar-V Crab Core",
    "image": "ghcr.io/agh-logic-unit/pv-crab-core:main",
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "settings": {
                "files.associations": {
                    "*.sv": "systemverilog",
                    "*.svh": "systemverilog",
                    "*.v": "verilog",
                    "*.vh": "verilog"
                },
                "python.defaultInterpreterPath": "/home/vscode/venv/bin/python3",
                "editor.formatOnSave": true,
                "editor.detectIndentation": false,
                "verilog.linting.linter": "verible-verilog-lint",
                "verilog.linting.veribleVerilogLint.path": "/usr/local/bin/verible-verilog-lint",
                "verilog.linting.veribleVerilogLint.arguments": "--rules_config .rules.verible_lint",
                "verilog.formatting.verilogHDL.formatter": "verible-verilog-format",
                "verilog.formatting.veribleVerilogFormatter.path": "/usr/local/bin/verible-verilog-format",
                "verilog.formatting.veribleVerilogFormatter.arguments": "--flagfile=.rules.verible_format",
                "verilog.languageServer.name": "svlangserver",
                "verilog.languageServer.svlangserver.path": "/usr/local/bin/svlangserver",
                "svlangserver.settings.includeIndexing": ["**/*.sv", "**/*.svh", "**/*.v", "**/*.vh"],
                "svlangserver.settings.excludeIndexing": ["output/**", "regression/**", ".cache/**", "site/**", "docs/**", "scripts/**"],
                "[verilog]": {
                    "editor.defaultFormatter": "mshr-h.veriloghdl",
                    "editor.formatOnSave": true,
                    "editor.insertSpaces": true,
                    "editor.tabSize": 2
                },
                "[systemverilog]": {
                    "editor.defaultFormatter": "mshr-h.veriloghdl",
                    "editor.formatOnSave": true,
                    "editor.insertSpaces": true,
                    "editor.tabSize": 2
                }
            },
            "extensions": [
                "mshr-h.veriloghdl",
                "surfer-project.surfer",
                "ms-python.python",
                "tamasfe.even-better-toml",
                "eamodio.gitlens"
            ]
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly,consistency=cached"
    ],
    "postCreateCommand": "pre-commit install && pre-commit install --hook-type commit-msg",
    "postAttachCommand": "bash .devcontainer/check.sh &"
}
